#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_000_HELLO_APP
	bool "Contest 2026 team 000 hello app"
	default n
	---help---
		Enable the contest 2026 team 000 hello app demo.

config LVX_USE_DEMO_CONTEST2026_128_WSS_TEST
	bool "Contest 2026 team 128 secure WebSocket test"
	default n
	depends on NET_TCP
	depends on NET_TCPPROTO_OPTIONS
	select LIBUV
	select CRYPTO_MBEDTLS
	select OPENSSL_MBEDTLS_WRAPPER
	select NETUTILS_LIBWEBSOCKETS
	---help---
		Build the wss_test NSH command.  It isolates DNS, TCP, TLS and the
		WebSocket HTTP Upgrade from the XiaoZhi application.

if LVX_USE_DEMO_CONTEST2026_128_WSS_TEST

config CONTEST2026_128_WSS_TEST_URL
	string "Secure WebSocket URL"
	default "wss://api.tenclass.net/xiaozhi/v1/"

config CONTEST2026_128_WSS_TEST_TIMEOUT
	int "Connection timeout in seconds"
	range 3 120
	default 15

config CONTEST2026_128_WSS_TEST_TLS_ALLOW_INSECURE
	bool "Allow unverified TLS for board bring-up"
	default n
	help
		Disable certificate and hostname verification.  Use only to isolate
		transport bring-up before a CA bundle is provisioned.

endif

config LVX_USE_DEMO_CONTEST2026_128_LCD_TEST
	bool "Contest 2026 team 128 LCD test"
	default n
	depends on LCD_DEV
	---help---
		Draw RGB565 color bars, a border, and a center cross through the
		NuttX /dev/lcd0 character-device interface.

config LVX_USE_DEMO_CONTEST2026_128_TOUCH_TEST
	bool "Contest 2026 team 128 touchscreen input test"
	default n
	depends on INPUT_TOUCHSCREEN
	---help---
		Open a NuttX touchscreen character device, report its ioctl
		capabilities, and print touch samples received through poll/read.

config LVX_USE_DEMO_CONTEST2026_128_PPA_TEST
	bool "Contest 2026 team 128 ESP32-P4 PPA functional test"
	default n
	depends on ESP32P4_PPA
	---help---
		Build the ppa_test NSH application.  It validates PPA output against
		an independent CPU reference and checks DMA guard regions.

config LVX_USE_DEMO_CONTEST2026_128_LVGL_PPA
	bool "Contest 2026 team 128 LVGL ESP32-P4 PPA demo"
	default n
	depends on ESP32P4_PPA
	depends on GRAPHICS_LVGL
	depends on LV_USE_NUTTX
	depends on LV_USE_NUTTX_LCD || VIDEO_FB
	---help---
		Build the lvgl_ppa NSH application and the application-side LVGL 9.1
		draw-unit adapter.  The adapter accelerates fills, RGB/A8/ARGB variable
		images, alpha blending, color keying, scaling, and right-angle rotation
		through PPA, leaving unsupported tasks to software.  Both the NuttX
		LCD character device and framebuffer backends are supported.  When
		the LVGL widgets demo is enabled, also build the lvgl_widget application
		with the same PPA draw unit registered before creating the widgets UI.
		When the LVGL benchmark demo is enabled, build two otherwise identical
		benchmark applications: lvglbench_ppa with the PPA draw unit registered,
		and lvglbench using LVGL's software renderer only.

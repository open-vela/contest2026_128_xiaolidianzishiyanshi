# include ${NUTTX_DIR}/arch/${CONFIG_ARCH}/src/common/Make.defs
# include ${NUTTX_DIR}/arch/${CONFIG_ARCH}/src/common/espressif/Make.defs
include common/Make.defs
include common/espressif/Make.defs

CHIP_CSRCS += esp_chip_rev.c
CHIP_CSRCS += esp_clic.c esp_fpu.c

ifeq ($(CONFIG_ESPRESSIF_MIPI_DSI),y)
	CHIP_CSRCS += esp_mipi_dsi.c
endif

ifeq ($(CONFIG_ESPRESSIF_MIPI_CSI),y)
	CHIP_CSRCS += esp_mipi_csi.c
endif

ifeq ($(CONFIG_ESP32P4_PPA),y)
	CHIP_CSRCS += esp32p4_ppa.c esp32p4_ppa_hal.c esp32p4_ppa_dma2d.c
endif

ifeq ($(CONFIG_ARCH_FPU),y)
	LDFLAGS += --wrap=riscv_restorefpu
endif

CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING

# TODO: Remove these flags once ulp/lp_core/lp_core.c is updated.
CFLAGS += -Wno-array-bounds -Wno-stringop-overflow

# Convenience target to print current Make environment variables
.PHONY: print-make-env
print-make-env:
	@echo "---- Make environment variables ----"
	@env | sort
